# TufTracker Backend — environment template (S1).
# Copy to `.env` and fill in real values. NEVER commit `.env` (gitignored).
# All values below are obvious placeholders: booting with them in
# NODE_ENV=production is refused by config/env.validation.js.

# One of: development | test | production
NODE_ENV=development

# API listen port (1-65535) and bind host.
PORT=5001
# HOST is optional. Defaults: 127.0.0.1 in dev/test, 0.0.0.0 in production
# (container requirement). Set HOST=0.0.0.0 explicitly for LAN dev access.
#HOST=127.0.0.1

# Public HTTPS origin of the frontend (no trailing slash). Required in
# production, where it must be https and must not be localhost.
FRONTEND_URL=http://localhost:5173

# Public HTTPS origin of this backend (used by cron/self-pings).
# Required in production and must NOT be localhost there.
BACKEND_URL=http://localhost:5001

# Firebase Admin service-account JSON on ONE line (Project Settings >
# Service Accounts > Generate new private key). Required in production.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"}

# Optional. Realtime-Database URL (passed to Admin SDK when set).
#FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.your-region.firebasedatabase.app

# AI provider key. At least one required in production; values that look
# like placeholders or short/weak strings refuse to boot everywhere.
GROQ_API_KEY=your-groq-api-key-here
#OPENROUTER_API_KEY=your-openrouter-api-key-here

# S2: server-side admin allowlist (comma-separated). Optional; when unset,
# ADMIN-gated routes (e.g. POST /api/quotes/refresh) deny everyone.
#ADMIN_EMAILS=you@example.com
